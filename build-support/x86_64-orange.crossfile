[binaries]
c = 'x86_64-orange-mlibc-gcc'
cpp = 'x86_64-orange-mlibc-g++'
ar = 'x86_64-orange-mlibc-ar'
nm = 'x86_64-orange-mlibc-nm'
strip = 'x86_64-orange-mlibc-strip'
pkg-config = 'pkg-config'
llvm-config = 'llvm-config'
g-ir-scanner = 'orange-g-ir-scanner'
g-ir-generate = 'orange-g-ir-generate'
g-ir-compiler = 'orange-g-ir-compiler'
exe_wrapper = 'run-wrapper'

[host_machine]
system = 'orange'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
