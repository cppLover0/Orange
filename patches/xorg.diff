diff -Naur xorg/meson.build xorg-clean/meson.build
--- xorg/meson.build	2026-04-14 16:32:43.000000000 +0300
+++ xorg-clean/meson.build	2026-04-27 07:03:37.702931550 +0300
@@ -166,9 +166,11 @@
 
 build_udev = get_option('udev')
 build_udev_kms = get_option('udev_kms')
+evdev_option = get_option('evdev')
 if ['windows',  'darwin', 'cygwin'].contains(host_machine.system())
     build_udev = false
     build_udev_kms = false
+    evdev_option = 'false'
     hal_option = 'false'
 endif
 
@@ -276,6 +278,16 @@
     error('Hotplugging through both libudev and hal not allowed')
 endif
 
+if evdev_option == 'auto'
+    build_evdev = not build_udev and not build_hal and host_machine.system() == 'orange'
+else
+    build_evdev = evdev_option == 'true'
+endif
+
+if build_evdev and (build_udev or build_hal)
+    error('Hotplugging through evdev cannot be combined with libudev or hal')
+endif
+
 build_dbus = build_hal or build_systemd_logind
 
 udev_dep = dependency('', required:false)
