diff -Naur xorg/config/evdev.c xorg-clean/config/evdev.c
--- xorg/config/evdev.c	1970-01-01 03:00:00.000000000 +0300
+++ xorg-clean/config/evdev.c	2026-04-27 07:03:37.700598346 +0300
@@ -0,0 +1,303 @@
+/*
+ * Copyright © 2026 The Astral contributors
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
