+/*
+ * called at init time when XDMCP will be used; xdmcp always
+ * adds local hosts manually when needed
+ */
+
+void
+AccessUsingXdmcp(void)
+{
+    UsingXdmcp = TRUE;
+    LocalHostEnabled = FALSE;
+}
