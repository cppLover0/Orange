+license = "MIT OR Apache-2.0"
+repository = "https://github.com/rust-lang/libc"
+rust-version = "1.65"
+
+[package.metadata.docs.rs]
+features = ["extra_traits"]
+default-target = "x86_64-unknown-linux-gnu"
