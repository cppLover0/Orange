diff --git glib2-clean/glib/gthread.c glib2-workdir/glib/gthread.c
--- glib2-clean/glib/gthread.c
+++ glib2-workdir/glib/gthread.c
@@ -771,7 +771,16 @@
   gsize *value_location = (gsize *) location;
   gsize old_value;
 
-  g_return_if_fail (result != 0);
+  if (G_UNLIKELY (result == 0))
+    {
+      g_critical ("g_once_init_leave: result == 0 for location %p, removing the failed initialisation so it can be retried", value_location);
+      g_mutex_lock (&g_once_mutex);
+      if (g_once_init_list != NULL)
+        g_once_init_list = g_slist_remove (g_once_init_list, (void *) value_location);
+      g_cond_broadcast (&g_once_cond);
+      g_mutex_unlock (&g_once_mutex);
+      return;
+    }
 
   old_value = (gsize) g_atomic_pointer_exchange (value_location, result);
   g_return_if_fail (old_value == 0);
@@ -807,7 +816,16 @@
   gpointer *value_location = (gpointer *) location;
   gpointer old_value;
 
-  g_return_if_fail (result != 0);
+  if (G_UNLIKELY (result == NULL))
+    {
+      g_critical ("g_once_init_leave_pointer: result == NULL for location %p, removing the failed initialisation so it can be retried", value_location);
+      g_mutex_lock (&g_once_mutex);
+      if (g_once_init_list != NULL)
+        g_once_init_list = g_slist_remove (g_once_init_list, (void *) value_location);
+      g_cond_broadcast (&g_once_cond);
+      g_mutex_unlock (&g_once_mutex);
+      return;
+    }
 
   old_value = g_atomic_pointer_exchange (value_location, result);
   g_return_if_fail (old_value == 0);
